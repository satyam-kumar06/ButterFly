        "p": {
          "maximum": 1,
          "minimum": 0,
          "title": "P",
          "type": "number"
        }
      },
      "required": [
        "type",
        "p"
      ],
      "title": "Bernoulli",
      "type": "object"
    },
    "Discrete": {
