        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "editable": {
          "default": true,
          "title": "Editable",
          "type": "boolean"
        },
        "sweep_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/SweepRange"
