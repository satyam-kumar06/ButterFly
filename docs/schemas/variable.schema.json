{
  "$defs": {
    "Bernoulli": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "bernoulli",
          "title": "Type",
          "type": "string"
        },
        "p": {
          "maximum": 1,
          "minimum": 0,
          "title": "P",
          "type": "number"
        }
      },
      "required": [
        "type",
        "p"
      ],
      "title": "Bernoulli",
      "type": "object"
    },
    "Discrete": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "discrete",
          "title": "Type",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        },
        "probs": {
          "items": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "minItems": 1,
          "title": "Probs",
          "type": "array"
        }
      },
      "required": [
        "type",
        "values",
        "probs"
      ],
      "title": "Discrete",
      "type": "object"
    },
    "DistributionVariable": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "user",
            "default",
            "data"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "confirmed": {
          "default": false,
          "title": "Confirmed",
          "type": "boolean"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "editable": {
          "default": true,
          "title": "Editable",
          "type": "boolean"
        },
        "sweep_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/SweepRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "const": "distribution",
          "title": "Kind",
          "type": "string"
        },
        "dist": {
          "discriminator": {
            "mapping": {
              "bernoulli": "#/$defs/Bernoulli",
              "discrete": "#/$defs/Discrete",
              "lognormal": "#/$defs/Lognormal",
              "normal": "#/$defs/Normal",
              "triangular": "#/$defs/Triangular",
              "uniform": "#/$defs/Uniform"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Normal"
            },
            {
              "$ref": "#/$defs/Lognormal"
            },
            {
              "$ref": "#/$defs/Uniform"
            },
            {
              "$ref": "#/$defs/Triangular"
            },
            {
              "$ref": "#/$defs/Bernoulli"
            },
            {
              "$ref": "#/$defs/Discrete"
            }
          ],
          "title": "Dist"
        }
      },
      "required": [
        "source",
        "source_ref",
        "name",
        "unit",
        "kind",
        "dist"
      ],
      "title": "DistributionVariable",
      "type": "object"
    },
    "FixedVariable": {
      "additionalProperties": false,
