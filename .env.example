# Copy to .env at repository root. Never commit real values.
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Candidate IDs from the public catalog; scripts/check_platform.py verifies your access.
MODEL_NANO=nvidia/Nemotron-3-Nano-30B-A3B
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
SANDBOX_API_KEY=
NEBIUS_PROJECT_ID=
SANDBOX_BASE_URL=https://api.tokenfactory.nebius.com/sandboxes
SANDBOX_BASE_IMAGE=alpine:3.19
SANDBOX_MAX_CONCURRENCY=4
# Only VITE_ variables may be exposed to the frontend. Never prefix a key with VITE_.
VITE_MOCK=1
VITE_API_BASE_URL=http://localhost:8000
